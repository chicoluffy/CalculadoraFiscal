<Window x:Class="CalculadoraFiscalUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora de Nómina Quincenal" 
        Height="701" Width="1491"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="#F7F9FC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="CenterCheckBox" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <!-- 🔹 TAB CONTROL -->
        <TabControl x:Name="TabPrincipal" Margin="0,0,0,10">

            <!-- ================= PESTAÑA 1: NÓMINA ================= -->
            <TabItem Header="Nómina" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Input Salario -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,15">
                            <TextBlock Text="Salario Bruto Quincenal:" 
                                       VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0"/>
                            <TextBox x:Name="TxtSalario" Width="160" FontSize="15" Padding="8,6" 
                                     Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <Button Content="Calcular" Click="BtnCalcular_Click" 
                                    Width="110" Margin="20,0,0,0" Padding="0,8"
                                    Background="#0078D4" Foreground="White" FontSize="14" FontWeight="SemiBold" 
                                    BorderBrush="Transparent" Cursor="Hand"/>
                            <Button Content="Limpiar" Click="BtnLimpiar_Click" 
                                    Width="90" Margin="10,0,0,0" Padding="0,8"
                                    Background="#6B7280" Foreground="White" FontSize="14" 
                                    BorderBrush="Transparent" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Otros Descuentos -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="➕ Otros Descuentos:" 
                                       VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0"
                                       Foreground="#6B7280"/>
                            <TextBox x:Name="TxtOtrosDescuentos" Width="160" FontSize="14" Padding="8,6" 
                                     Background="White" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <TextBlock Text="(Opcional)" FontStyle="Italic" Foreground="#9CA3AF" 
                                       VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                        </StackPanel>

                        <!-- Deducciones -->
                        <GroupBox Grid.Row="2" Header="📉 Deducciones de Ley" 
                                  FontSize="14" FontWeight="Bold" Padding="15" Margin="0,0,0,15"
                                  BorderBrush="#E0E0E0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="LblISR" Text="ISR (Renta): $0.00" Margin="0,6" FontSize="13"/>
                                    <TextBlock x:Name="LblSS" Text="Seguro Social (9.75%): $0.00" Margin="0,6" FontSize="13"/>
                                    <TextBlock x:Name="LblSE" Text="Seguro Educativo (1.25%): $0.00" Margin="0,6" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock x:Name="LblOtros" Text="Otros Descuentos: $0.00" 
                                               Margin="0,6" FontSize="13" Foreground="#7C3AED"/>
                                    <TextBlock x:Name="LblTotalDed" Text="Total Deducciones: $0.00" 
                                               Margin="0,6" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Resultados Netos -->
                        <Border Grid.Row="3" Background="#F0F9FF" CornerRadius="8" Padding="20" Margin="0,0,0,15" BorderBrush="#BAE6FD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="LblNetoLegal" 
                                           Text="📋 Neto después de impuestos: $0.00" 
                                           HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,12"/>
                                <TextBlock x:Name="LblSeparador" Text="─ Otros descuentos aplicados ─" 
                                           HorizontalAlignment="Center" FontSize="11" Foreground="#94A3B8" FontStyle="Italic" Margin="0,0,0,8" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblNetoFinal" 
                                           Text="💰 Salario Final a Recibir: $0.00" 
                                           HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock x:Name="LblAyuda" Text="" 
                                           HorizontalAlignment="Center" FontSize="11" Foreground="#64748B" FontStyle="Italic" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Botón para ir a Gastos -->
                        <Button Grid.Row="4" Content="📝 Ir a registrar mis gastos →" 
                                Click="BtnIrAGastos_Click" HorizontalAlignment="Center" 
                                Padding="20,10" FontSize="14" Background="#10B981" Foreground="White"
                                BorderBrush="Transparent" Cursor="Hand" Margin="0,20,0,0"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================= PESTAÑA 2: GASTOS ================= -->
            <TabItem Header="📝 Gastos" FontSize="14" Height="25" Margin="-2,0,-2,0" VerticalAlignment="Top">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 🔹 Selector de Quincena (NUEVO) -->
                    <GroupBox Grid.Row="0" Header="📅 Periodo" FontSize="12" FontWeight="Bold" Padding="8" Margin="0,0,0,8" BorderBrush="#E5E7EB">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Año:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox x:Name="CmbAnio" Width="80" FontSize="12" Margin="0,0,15,0" SelectionChanged="CmbPeriodo_SelectionChanged"/>
                            <TextBlock Text="Quincena:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                            <ComboBox x:Name="CmbQuincena" Width="180" FontSize="12" Margin="0,0,15,0" SelectionChanged="CmbPeriodo_SelectionChanged">
                                <ComboBoxItem Content="1ra Q (Cobro día 15)" Tag="1"/>
                                <ComboBoxItem Content="2da Q (Cobro día 30)" Tag="2"/>
                            </ComboBox>
                            <Button Content="💾 Guardar" Click="BtnGuardarQuincena_Click" Width="85" FontSize="12" 
                                    Background="#3B82F6" Foreground="White" Cursor="Hand" Margin="0,0,8,0"/>
                            <Button Content="🗑️ Eliminar" Click="BtnEliminarQuincena_Click" Width="90" FontSize="12" 
                                    Background="#EF4444" Foreground="White" Cursor="Hand"/>
                            <TextBlock x:Name="LblEstadoGuardado" Text="" Margin="15,0,0,0" FontSize="11" Foreground="#059669" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>
                    <!-- 🔹 CONTEXTO DE PERÍODO (Row 1) -->
                    <Border Grid.Row="1" Background="#FEF3C7" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#FCD34D" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📅 Período Activo:" FontSize="12" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbMesContexto" Width="100" FontSize="12" Background="White" SelectionChanged="CmbContexto_SelectionChanged">
                                <ComboBoxItem Content="Enero" Tag="1" IsSelected="True"/>
                                <ComboBoxItem Content="Febrero" Tag="2"/>
                                <ComboBoxItem Content="Marzo" Tag="3"/>
                                <ComboBoxItem Content="Abril" Tag="4"/>
                                <ComboBoxItem Content="Mayo" Tag="5"/>
                                <ComboBoxItem Content="Junio" Tag="6"/>
                                <ComboBoxItem Content="Julio" Tag="7"/>
                                <ComboBoxItem Content="Agosto" Tag="8"/>
                                <ComboBoxItem Content="Septiembre" Tag="9"/>
                                <ComboBoxItem Content="Octubre" Tag="10"/>
                                <ComboBoxItem Content="Noviembre" Tag="11"/>
                                <ComboBoxItem Content="Diciembre" Tag="12"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbQMesContexto" Width="180" Margin="8,0,0,0" FontSize="12" Background="White" SelectionChanged="CmbContexto_SelectionChanged">
                                <ComboBoxItem Content="1ra Q (Cobro día 15)" Tag="1" IsSelected="True"/>
                                <ComboBoxItem Content="2da Q (Cobro día 30)" Tag="2"/>
                            </ComboBox>
                            <TextBlock Text="| 💵 Disponible:" Margin="15,0,5,0" FontSize="12" Foreground="#92400E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblSalarioDisponible" Text=" $0.00" FontSize="16" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock x:Name="LblReservaAhorro" Text="" FontSize="11" Foreground="#6366F1" FontStyle="Italic" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- ➕ AGREGAR GASTO AL PERÍODO ACTIVO (Row 2) -->
                    <GroupBox Grid.Row="2" Header="➕ Registrar Gasto" FontSize="12" FontWeight="Bold" Padding="10" Margin="0,0,0,10" BorderBrush="#E5E7EB">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtNombreGasto" Width="220" FontSize="12" Padding="6,5" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                 ToolTip="Concepto del gasto (ej: Supermercado, Luz, Gasolina)"/>
                            <TextBox x:Name="TxtMontoGasto" Width="120" FontSize="12" Padding="6,5" Margin="10,0,0,0" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                 ToolTip="Monto del gasto"/>
                            <Button Content="Agregar +" Click="BtnAgregarGasto_Click" Width="90" Margin="10,0,0,0" Background="#3B82F6" Foreground="White" FontSize="12" Cursor="Hand"/>
                            <Button Content="Limpiar Todo" Click="BtnLimpiarGastos_Click" Width="100" Margin="10,0,0,0" Background="#6B7280" Foreground="White" FontSize="12" Cursor="Hand"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 📋 DATAGRID (Row 3) - Se actualiza automáticamente al contexto -->
                    <Border Grid.Row="3" Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="5" Margin="0,0,0,10">
                        <DataGrid x:Name="DgGastos" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" FontSize="12" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Concepto" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C2}" Width="120"/>
                                <DataGridTemplateColumn Header="Acción" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" Click="BtnEliminarGasto_Click" Background="#EF4444" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Tag="{Binding}" Width="45" Height="22" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <!-- 💵 Resumen Final (COMPACTO) -->
                    <Border Grid.Row="4" Background="#ECFDF5" CornerRadius="6" Padding="12" BorderBrush="#6EE7B7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Total:" FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>
                            <TextBlock x:Name="LblTotalGastos" Text=" $0.00" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="5,0,20,0"/>
                            <TextBlock Text="| Saldo:" FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>
                            <TextBlock x:Name="LblSaldoRestante" Text=" $0.00" FontSize="16" FontWeight="Bold" Foreground="#059669" Margin="5,0,0,0"/>
                            <TextBlock x:Name="LblMensajeSaldo" Text="" FontSize="11" FontStyle="Italic" Foreground="#6B7280" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Ahorro" FontSize="14" Height="25" VerticalAlignment="Top">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Configuración de Plan y Metas -->
                    <GroupBox Grid.Row="0" Header="⚔️ Plan Quincenal de Ahorro &amp; Metas" FontSize="13" FontWeight="Bold" Padding="12" Margin="0,0,0,12" BorderBrush="#6366F1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Fila 1: Nombre, Meta Total Calculada y Fecha -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="🏆 Meta General:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtNombreMeta" Width="200" FontSize="12" Padding="5,4" Background="White" BorderBrush="#E5E7EB" 
                                         ToolTip="Nombre de tu objetivo (ej: Casa + Moto)"/>

                                <TextBlock Text="💰 Meta Total ($):" 
                                           ToolTip="Suma automática de tus metas (Casa + Moto = $9,300)" 
                                           Margin="15,0,8,0" FontSize="12" VerticalAlignment="Center"/>     
                                <TextBox x:Name="TxtMetaMonto" Width="100" FontSize="12" Padding="5,4" Background="#F3F4F6" BorderBrush="#E5E7EB" IsReadOnly="True" FontWeight="Bold"/>

                                <TextBlock Text="📅 Fecha Límite:" Margin="15,0,8,0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Diciembre 2027 🎯" FontSize="12" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Fila 2: Plan Q1, Q2 y Décimos -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="1ra Q ($):" ToolTip="Plan de ahorro para la 1ra quincena" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="TxtAporteQ1" Width="70" FontSize="12" Padding="4" Text="300" Background="White" BorderBrush="#E5E7EB"/>

                                <TextBlock Text="2da Q ($):" ToolTip="Plan de ahorro para la 2da quincena" Margin="12,0,5,0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtAporteQ2" Width="70" FontSize="12" Padding="4" Text="350" Background="White" BorderBrush="#E5E7EB"/>

                                <TextBlock Text="🎁 Décimo ($):" ToolTip="Monto por cada décimo cuatrimestral (Abr, Ago, Dic)" Margin="12,0,5,0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtMontoDecimo" Width="75" FontSize="12" Padding="4" Text="588" Background="White" BorderBrush="#E5E7EB"/>

                                <Button Content="📌 Guardar Plan" Click="BtnFijarMeta_Click" Width="105" Margin="15,0,0,0" Background="#6366F1" Foreground="White" FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Barra de Progreso RPG, Tarjetas por Cuenta y Proyección -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Nivel y Porcentaje Global -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Name="LblNivel" Text="🟢 Nivel 1: Novato" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="LblPorcentaje" Text="0%" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="20,0,0,0"/>
                            </StackPanel>

                            <!-- Barra General -->
                            <ProgressBar x:Name="PgbProgreso" Height="18" Background="#334155" BorderBrush="#475569" BorderThickness="1" Foreground="#10B981" Margin="0,0,0,12">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                                            <Border x:Name="PART_Indicator" CornerRadius="9" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.7"/>
                                                </Border.Effect>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>

                            <!-- 🏠 DESGLOSE DE CUENTAS / SUB-METAS (CASA & MOTO) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cuenta 1: Gastos Legales -->
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,6,0" BorderBrush="#3B82F6" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🏠 Gastos Legales Casa" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <TextBlock x:Name="LblSub1Monto" Text="$0 / $1,600" FontSize="11" Foreground="#F3F4F6" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblSub1Pct" Text=" (0%)" FontSize="11" Foreground="#93C5FD"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="PgbSub1" Height="8" Background="#1E293B" Foreground="#3B82F6" Value="0" Maximum="100"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cuenta 2: Abono Inicial -->
                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="10" Margin="3,0,3,0" BorderBrush="#10B981" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🏠 Abono Inicial Casa" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <TextBlock x:Name="LblSub2Monto" Text="$0 / $3,500" FontSize="11" Foreground="#F3F4F6" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblSub2Pct" Text=" (0%)" FontSize="11" Foreground="#6EE7B7"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="PgbSub2" Height="8" Background="#1E293B" Foreground="#10B981" Value="0" Maximum="100"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cuenta 3: Moto -->
                                <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="10" Margin="6,0,0,0" BorderBrush="#A855F7" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🏍️ Moto (con ITBMS)" FontSize="11" FontWeight="Bold" Foreground="#C084FC"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <TextBlock x:Name="LblSub3Monto" Text="$0 / $4,200" FontSize="11" Foreground="#F3F4F6" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="LblSub3Pct" Text=" (0%)" FontSize="11" Foreground="#E9D5FF"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="PgbSub3" Height="8" Background="#1E293B" Foreground="#A855F7" Value="0" Maximum="100"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Acumulado y Proyección Dic 2027 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                                <TextBlock Text="💰 Acumulado:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="LblActual" Text=" $0.00" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="5,0,15,0"/>
                                <TextBlock Text="| 🚀 Proyectado a Dic 2027:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="LblProyeccionDic2027" Text=" $0.00" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="5,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LblEstadoMeta2027" Text="✨ Listo para evaluar tu proyección" HorizontalAlignment="Center" FontSize="11" FontStyle="Italic" Foreground="#FBBF24" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Agregar Ahorro (Con Selector de Tipo y Selector de Cuenta Destino) -->
                    <GroupBox Grid.Row="2" Header="💎 Registrar Depósito de Ahorro" FontSize="13" FontWeight="Bold" Padding="12" Margin="0,0,0,12" BorderBrush="#6366F1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Monto ($):" VerticalAlignment="Center" FontSize="12" Margin="0,0,5,0"/>
                            <TextBox x:Name="TxtDepositoAhorro" Width="85" FontSize="12" Padding="5,4" Background="White" BorderBrush="#E5E7EB"/>

                            <TextBlock Text="Tipo:" VerticalAlignment="Center" FontSize="12" Margin="10,0,5,0"/>
                            <ComboBox x:Name="CmbTipoDeposito" Width="145" FontSize="12" Padding="4" SelectionChanged="CmbTipoDeposito_SelectionChanged">
                                <ComboBoxItem Content="1ra Quincena ($300)" Tag="Aporte Q1" IsSelected="True"/>
                                <ComboBoxItem Content="2da Quincena ($350)" Tag="Aporte Q2"/>
                                <ComboBoxItem Content="🎁 Décimo ($588)" Tag="Décimo"/>
                                <ComboBoxItem Content="Depósito Extra" Tag="Extra"/>
                            </ComboBox>

                            <TextBlock Text="Destino:" VerticalAlignment="Center" FontSize="12" Margin="10,0,5,0"/>
                            <ComboBox x:Name="CmbDestinoDeposito" Width="200" FontSize="12" Padding="4">
                                <ComboBoxItem Content="⚡ Auto (Casa Legales → Abono → Moto)" Tag="AUTO" IsSelected="True"/>
                                <ComboBoxItem Content="🏠 Casa - Gastos Legales ($1,600)" Tag="SUB1"/>
                                <ComboBoxItem Content="🏠 Casa - Abono Inicial ($3,500)" Tag="SUB2"/>
                                <ComboBoxItem Content="🏍️ Moto (con ITBMS) ($4,200)" Tag="SUB3"/>
                            </ComboBox>

                            <Button Content="⬆️ Depositar" Click="BtnAgregarAhorro_Click" Width="95" Margin="12,0,0,0" Background="#8B5CF6" Foreground="White" FontSize="12" Cursor="Hand"/>
                            <TextBlock x:Name="LblFeedback" Text="" Margin="12,0,0,0" FontSize="11" FontStyle="Italic" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Historial -->
                    <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                        <DataGrid x:Name="DgHistorialAhorro" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="11" RowHeight="26" Background="Transparent" BorderBrush="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="80"/>
                                <DataGridTextColumn Header="Periodo" Width="70">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}-Q{1}">
                                            <Binding Path="Anio"/>
                                            <Binding Path="Quincena"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Destino" Binding="{Binding SubMetaNombre}" Width="160"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                                <DataGridTextColumn Header="Aporte" Binding="{Binding Monto, StringFormat=C2}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Button Grid.Row="4" Content="💾 Guardar Progreso de Ahorro" Click="BtnGuardarAhorro_Click" HorizontalAlignment="Center" Padding="20,8" FontSize="13" Background="#059669" Foreground="White" Cursor="Hand"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Pie de página -->
        <TextBlock Grid.Row="1" Text="💡 Tip: Actualiza tu salario en 'Nómina' para refrescar el saldo disponible en 'Gastos'" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Foreground="#9CA3AF" FontStyle="Italic" FontSize="10"/>
    </Grid>
</Window>
